#!/bin/bash

### Called after the user installs the application: bring the service up.

set -u

MAIN_SCRIPT="$(dirname "$0")/main"

if [ ! -x "${MAIN_SCRIPT}" ]; then
    chmod +x "${MAIN_SCRIPT}" 2>/dev/null || true
fi

if [ -x "${MAIN_SCRIPT}" ]; then
    "${MAIN_SCRIPT}" start || true
fi

exit 0
